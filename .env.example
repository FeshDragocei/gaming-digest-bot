# ===== Токен бота (получить у @BotFather) =====
BOT_TOKEN=1234567890:AAA-your-token-here

# ===== Куда постить новости =====
# ID канала (например -1001234567890) или @имя_канала (если канал публичный)
CHANNEL_ID=@my_gaming_channel

# ===== Проверка новых новостей =====
CHECK_INTERVAL_MINUTES=30   # как часто проверять (в минутах)
NEWS_PER_RUN=5              # максимум новостей за одну проверку
FRESH_HOURS=12              # брать новости за последние N часов
TIMEZONE=Europe/Moscow
