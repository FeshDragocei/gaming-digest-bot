# ===== Токен бота (получить у @BotFather) =====
BOT_TOKEN=1234567890:AAA-your-token-here

# ===== Куда постить новости =====
# ID канала (например -1001234567890) или @имя_канала (если канал публичный)
CHANNEL_ID=@my_gaming_channel

# ===== Проверка новых новостей =====
CHECK_INTERVAL_MINUTES=30   # как часто таймер будит бота (бот сам держит паузу)
NEWS_PER_RUN=5              # максимум новостей за одну публикацию
TOPIC_BATCH_CAP=3           # максимум новостей одной темы за проверку
TOPIC_DAILY_CAP=8           # максимум новостей одной темы за сутки
PUBLISH_EVERY_HOURS=3       # минимальная пауза между публикациями (часы)
FRESH_HOURS=12              # брать новости за последние N часов
TIMEZONE=Europe/Moscow
